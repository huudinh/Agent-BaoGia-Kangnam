  "mo_dau": {
   "tieu_de": "Đôi mắt mở hơn — mà vẫn là mắt của chị",
   "loi_mo": "Em tổng hợp lại những gì chị chia sẻ hôm qua thành một phương án cụ thể, kèm chi phí dự tính để chị dễ hình dung trước khi tới khám. Đây là báo giá tham khảo riêng cho trường hợp của chị, không phải bảng giá chung."
  },
  "van_de_giai_phap": [
   {
    "van_de": "Mí một nếp, da mí trên hơi dư nên mắt nhìn hay buồn ngủ.",
    "giai_phap": "Lấy bớt phần mỡ làm mí nặng rồi tạo nếp theo tỉ lệ gương mặt — vùng mí gọn lại nên nếp ăn sâu đều hơn."
